# AWS Network-Ops Agent — example environment configuration.
# Copy to .env and fill in YOUR values. Nothing here is environment-specific
# in the code; this file is the single place you point the agent at your setup.
# NEVER commit your real .env (it is git-ignored).

# --- Core AWS ---
AWS_REGION=ap-southeast-1
# Account id(s) the agent is allowed to read (comma-separated).
AWS_ACCOUNT_IDS=123456789012
# Amazon Bedrock model id to use for the agent LLM.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# --- What "your" domains are (used by the FQDN tracer) ---
# Comma-separated apex/hosted domains the agent should treat as internal.
HOSTED_DOMAINS=example.com

# --- External WAF integration (optional; leave blank to disable) ---
WAF_PROVIDER=
WAF_BASE_URL=
# Provide the WAF API token via your secrets store, NOT here.
# F5_API_TOKEN is read from the environment / AWS Secrets Manager at runtime.

# --- Corporate egress allowlist (used by ip_lookup_tool) ---
# Path to your Terraform SCP allowlist. A template ships at the path below —
# replace its example CIDRs with your own.
NETWORK_ALLOWLIST_PATH=src/corporate-network-whitelist.tf

# --- Teams integration (optional) ---
API_GATEWAY_URL=
TEAMS_INCOMING_WEBHOOK_URL=

# --- AWS credentials ---
# NOT set here. The agent uses your standard AWS credential chain
# (environment, SSO profile, or an assumed read-only role).
